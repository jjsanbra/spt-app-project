#!/bin/sh

echo "🚀 [Pre-push Hook] Ejecutando validaciones antes de subir a remoto..."

# 1. Validación de ESLint
echo "\n🔍 1/3 Comprobando Linter..."
npm run lint
if [ $? -ne 0 ]; then
  echo "❌ Error en ESLint. Corrige los fallos antes de hacer push."
  exit 1
fi

# 2. Validación de Integridad OpenSpec
echo "\n📋 2/3 Verificando especificaciones OpenSpec..."
npm run spec:check
if [ $? -ne 0 ]; then
  echo "❌ Error en especificaciones OpenSpec. Revisa que estén completas y archivadas."
  exit 1
fi

# 3. Verificación de Cobertura en Código Nuevo
echo "\n🧪 3/3 Verificando cobertura en código nuevo/modificado..."
node scripts/check-coverage-diff.js
if [ $? -ne 0 ]; then
  echo "❌ Error de cobertura. El código nuevo debe alcanzar al menos el 80%."
  exit 1
fi

echo "\n✅ Todas las validaciones pre-push superadas. Continuando con git push...\n"
exit 0

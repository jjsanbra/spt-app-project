{
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ],
      "alwaysLoad": true
    },
    "primeng": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@primeng/mcp"
      ]
    }
  }
}

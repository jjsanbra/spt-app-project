# =====================================================
# SPT APP — Variables de Entorno
# Copia este fichero a .env y completa los valores
# NUNCA subas .env al repositorio
# =====================================================

# ─── Entorno ──────────────────────────────────────
NODE_ENV=development

# ─── Backend ──────────────────────────────────────
PORT=3000

# ─── Base de Datos (PostgreSQL) ───────────────────
# Desarrollo local (docker-compose en puerto 5433 para evitar colisión con Postgres nativo):
DATABASE_URL=postgresql://spt_user:spt_pass@localhost:5433/spt_db
# Producción (Render managed PostgreSQL):
# DATABASE_URL=postgresql://user:pass@host.render.com:5432/spt_db

# ─── Redis ────────────────────────────────────────
# Desarrollo local (docker-compose):
REDIS_URL=redis://localhost:6379
# Producción (Render managed Redis):
# REDIS_URL=redis://red-xxxx.render.com:6379

# ─── JWT ──────────────────────────────────────────
# Mínimo 64 caracteres en producción — genera con: openssl rand -hex 32
JWT_ACCESS_SECRET=changeme_access_secret_min_64_chars_use_openssl_in_production
JWT_REFRESH_SECRET=changeme_refresh_secret_min_64_chars_use_openssl_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email (Transaccional) ────────────────────────
# Desarrollo: usar Ethereal (https://ethereal.email) o Mailtrap
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="SPT App <noreply@spt-app.local>"

# ─── URLs de Microfrontends ───────────────────────
# Desarrollo local:
MFE_ADMIN_URL=http://localhost:4201
MFE_PORTAL_URL=http://localhost:4202
MFE_USERS_URL=http://localhost:4203
# Producción (Render Static Sites):
# MFE_ADMIN_URL=https://spt-admin.onrender.com
# MFE_PORTAL_URL=https://spt-portal.onrender.com
# MFE_USERS_URL=https://spt-users.onrender.com

# ─── CORS ─────────────────────────────────────────
CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202,http://localhost:4203

# ─── Frontend (Angular build) ─────────────────────
FRONTEND_URL=http://localhost:4200

# ─── Rate Limiting ────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# ─── BullMQ / Queue ───────────────────────────────
QUEUE_NAME=spt-notifications

# ─── Notificaciones SMS (Twilio) ─────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_FROM=

# ─── Notificaciones Push (FCM) ────────────────────
# FCM_SERVER_KEY= (activar cuando haya app móvil)

# ─── Almacenamiento (Avatares/Imágenes) ───────────
# Fase 2: decidir entre Cloudinary / S3
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
